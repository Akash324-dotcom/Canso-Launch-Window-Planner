# Credentials for the weather layer. Copy this file to backend/weather/.env and replace the placeholders,
# or export the same variables in the shell. backend/weather/.env is ignored by git. Never commit a real key.
#
# Copernicus Climate Data Store (ERA5). The personal access token is shown on the profile page of
# https://cds.climate.copernicus.eu after login. The dataset licence must be accepted once on the website.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=REPLACE_WITH_YOUR_CDS_PERSONAL_ACCESS_TOKEN
